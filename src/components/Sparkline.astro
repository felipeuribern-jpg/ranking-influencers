---
import type { HistoryPoint } from "../lib/data";
import type { LanguageCode } from "../../site.config";
import { formatNumber, formatDate } from "../lib/format";
import copy from "../lib/ux-copy.json";
interface Props {series:HistoryPoint[]; label:string; lang:LanguageCode;}
const {series,label,lang}=Astro.props;
const max=Math.max(...series.map(p=>p.total),1);
const first=series[0], last=series.at(-1);
const start=first ? new Date(first.date).getTime():0;
const duration=last ? new Date(last.date).getTime()-start:1;
const points=series.map(p=>`${52+(new Date(p.date).getTime()-start)/(duration||1)*480},${126-p.total/max*106}`).join(" ");
const shortDate=(d:string)=>new Intl.DateTimeFormat(lang,{day:"numeric",month:"short",timeZone:"UTC"}).format(new Date(d));
---
{series.length>=2 ? <figure class="history-chart">
 <figcaption><span>{formatDate(first.date,lang)} — {formatDate(last!.date,lang)}</span><strong>{formatNumber(last!.total,lang)}</strong></figcaption>
 <svg viewBox="0 0 550 154" role="img" aria-label={`${label}: ${formatNumber(first.total,lang)} → ${formatNumber(last!.total,lang)}`}>
   <line x1="52" x2="532" y1="20" y2="20" stroke="var(--rule)"/>
   <line x1="52" x2="532" y1="126" y2="126" stroke="var(--rule)"/>
   <text x="46" y="24" text-anchor="end">{formatNumber(max,lang)}</text><text x="46" y="130" text-anchor="end">0</text>
   <polyline points={points} fill="none" stroke="var(--accent)" stroke-width="3" stroke-linejoin="round"/>
   <text x="52" y="150">{shortDate(first.date)}</text><text x="532" y="150" text-anchor="end">{shortDate(last!.date)}</text>
 </svg>
 <details><summary>{label}</summary><table class="w"><tbody>{series.map(p=><tr><th scope="row">{formatDate(p.date,lang)}</th><td>{formatNumber(p.total,lang)}</td></tr>)}</tbody></table></details>
</figure> : <p class="empty">{copy[lang].historyEmpty}</p>}
<style>
.history-chart {margin:0;} figcaption {display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;color:var(--muted);font-size:14px;} figcaption strong {font-size:24px;color:var(--ink);} svg {width:100%;height:auto;display:block;max-height:240px;margin-block:16px;direction:ltr;} text {fill:var(--muted);font:13px system-ui;} summary {cursor:pointer;min-height:44px;padding-block:12px;color:var(--muted);font-size:14px;}
</style>
