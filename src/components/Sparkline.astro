---
import type { HistoryPoint } from "../lib/data";

interface Props {
  series: HistoryPoint[];
  width?: number;
  height?: number;
  label: string;
}

const { series, width = 280, height = 64, label } = Astro.props;
const values = series.map((p) => p.total);
const min = Math.min(...values, 0);
const max = Math.max(...values, 1);
const range = max - min || 1;

const points = series.map((p, i) => {
  const x = series.length > 1 ? (i / (series.length - 1)) * width : width / 2;
  const y = height - ((p.total - min) / range) * height;
  return `${x.toFixed(1)},${y.toFixed(1)}`;
});
const polyline = points.join(" ");
---

{
  series.length >= 2 ? (
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={label} class="sparkline">
      <polyline points={polyline} fill="none" stroke="var(--accent)" stroke-width="2" />
    </svg>
  ) : (
    <p class="empty" style="padding:8px 0">–</p>
  )
}

<style>
  .sparkline {
    width: 100%;
    height: 64px;
    display: block;
  }
</style>
