---
import { categoriesFor } from "../lib/exploration";
import type { LanguageCode } from "../../site.config";
import type { Person } from "../lib/data";
import { movement } from "../lib/data";
import { formatNumber } from "../lib/format";
import { translator } from "../lib/i18n";
import { PLATFORM_LABELS } from "../../pipeline/config.js";

interface Props {
  person: Person;
  position: number;
  prevPosition: number | null;
  lang: LanguageCode;
  lead?: boolean;
}

const { person, position, prevPosition, lang, lead = false } = Astro.props;
const t = translator(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const mv = movement(position, prevPosition);
const topic = person.topic[lang] ?? person.topic.es;
const mainPlatformLabel = person.mainPlatform ? PLATFORM_LABELS[person.mainPlatform] : "";
const countryCode = person.country.toUpperCase();
const countryName = new Intl.DisplayNames([lang], { type: "region" }).of(countryCode) ?? countryCode;
---

<a
  class:list={["row", { lead }]}
  href={`${base}/${lang}/p/${person.id}/`}
  data-position={position}
  data-country={person.country}
  data-name={person.name}
  data-topic={topic}
  data-categories={categoriesFor(person.topic.es).join(" ")}
  data-platform={person.mainPlatform ?? ""}
>
  <div class="pos">
    {position}
    {
      mv.kind === "new" && <span class="mv new">{t("rank.new")}</span>
    }
    {
      mv.kind === "same" && (
        <span class="mv same" aria-label={t("movement.sameAria")}>
          =
        </span>
      )
    }
    {
      mv.kind === "up" && (
        <span class="mv up" aria-label={t("movement.upAria", { n: mv.diff })}>
          ▲{mv.diff}
        </span>
      )
    }
    {
      mv.kind === "down" && (
        <span class="mv down" aria-label={t("movement.downAria", { n: mv.diff })}>
          ▼{mv.diff}
        </span>
      )
    }
  </div>
  <div class="who">
    <span class="avatar country-avatar" aria-hidden="true"><img src={`${base}/flags/${person.country.toLowerCase()}.svg`} alt="" width="42" height="42" loading="lazy" /></span>
    <span class="who-text">
      <strong class="creator-name"><span class="creator-name-text">{person.name}</span><span class="country-code" aria-label={countryName} title={countryName}>{countryCode}</span></strong>
      <small>{topic} · {mainPlatformLabel}</small>
    </span>
  </div>
  <div class="pts">
    {formatNumber(person.total, lang)}
    <small>{t("rank.scoreLabel")}</small>
  </div>
</a>
