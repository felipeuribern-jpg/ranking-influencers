---
import Layout from "../../../components/Layout.astro";
import Sparkline from "../../../components/Sparkline.astro";
import { siteConfig, type LanguageCode } from "../../../../site.config";
import { translator } from "../../../lib/i18n";
import { people, getHistorySeries } from "../../../lib/data";
import { countryName } from "../../../lib/countries";
import { formatCompactNumber, formatDate, formatNumber, formatPercent, formatSignedPercent } from "../../../lib/format";
import { PLATFORM_LABELS, type Platform } from "../../../../pipeline/config.js";

export function getStaticPaths() {
  return siteConfig.languages.flatMap((lang) =>
    people.map((person) => ({ params: { lang, id: person.id }, props: { person } } as const)),
  );
}

const { lang } = Astro.params as { lang: LanguageCode };
const { person } = Astro.props as { person: (typeof people)[number] };
const t = translator(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const topic = person.topic[lang] ?? person.topic.es;
const about = person.about[lang] ?? person.about.es;

const platformEntries = Object.entries(person.platforms) as Array<[Platform, NonNullable<(typeof person.platforms)[Platform]>]>;
platformEntries.sort((a, b) => b[1].points - a[1].points);

const mainData = person.mainPlatform ? person.platforms[person.mainPlatform] : null;
const mainUrl = mainData?.url ?? null;
const mainLabel = person.mainPlatform ? PLATFORM_LABELS[person.mainPlatform] : "";

const history = getHistorySeries(person.id, 90);
---

<Layout
  lang={lang}
  path={`p/${person.id}`}
  title={person.name}
  description={about}
>
  <div class="weekline">
    <h2 class="profile-title">
      <span class="avatar country-avatar profile-avatar" aria-hidden="true"><img src={`${base}/flags/${person.country.toLowerCase()}.svg`} alt="" width="42" height="42" loading="lazy" /></span>
      <span class="creator-name-text">{person.name}</span>
      <span class="country-code" aria-label={countryName(person.country, lang)} title={countryName(person.country, lang)}>{person.country.toUpperCase()}</span>
    </h2>
    <span>{topic} · {countryName(person.country, lang)}</span>
  </div>

  <div class="stats">
    <div class="stat"><b>#{person.rank}</b><span>{t("profile.world")}</span></div>
    <div class="stat"><b>#{person.countryRank}</b><span>{t("profile.inCountry")}</span></div>
    <div class="stat"><b>{formatNumber(person.total, lang)}</b><span>{t("rank.points")}</span></div>
  </div>

  <p>{about}</p>

  <div id="platforms">
    {
      platformEntries.map(([platform, data]) => (
        <div class:list={["plat", { main: platform === person.mainPlatform }]}>
          <span class="n">{PLATFORM_LABELS[platform]}</span>
          <span class="num">
            {data.followers != null ? formatCompactNumber(data.followers, lang) : "–"}
            {" · "}
            {data.er != null ? formatPercent(data.er, lang) : t("profile.engagementNA")}
          </span>
          <span class="num">
            <b>{formatNumber(data.points, lang)}</b> {t("rank.points")}
          </span>
        </div>
      ))
    }
  </div>

  {
    platformEntries.length > 0 && (
      <table class="w" style="margin-top:16px">
        <tr>
          <th>{" "}</th>
          <th>{t("profile.growth30")}</th>
          <th>{t("profile.lastUpdate")}</th>
        </tr>
        {platformEntries.map(([platform, data]) => (
          <tr>
            <td>{PLATFORM_LABELS[platform]}</td>
            <td>
              {data.followers != null && data.followers30 != null && data.followers30 > 0
                ? formatSignedPercent((data.followers - data.followers30) / data.followers30, lang)
                : "–"}
            </td>
            <td>
              {data.stale ? t("profile.stale") : formatDate(data.fetchedAt, lang)}
              {data.source && <span style="color:var(--muted)"> · {t("profile.source", { source: data.source })}</span>}
            </td>
          </tr>
        ))}
      </table>
    )
  }

  <h3 class="prose">{t("profile.evolution")}</h3>
  <Sparkline series={history} label={t("profile.evolution")} />

  {
    mainUrl ? (
      <a class="cta" href={mainUrl} target="_blank" rel="noopener">
        {t("profile.viewOn", { platform: mainLabel })}
      </a>
    ) : (
      <span class="cta" aria-disabled="true">
        {t("profile.viewOn", { platform: mainLabel || "–" })}
      </span>
    )
  }

  <div
    class="vote-widget"
    id="vote-widget"
    data-influencer-id={person.id}
    data-votes30={person.votes30}
    data-label-vote={t("vote.like")}
    data-label-done={t("vote.done")}
    data-label-sign-in={t("vote.signIn")}
    data-label-send={t("vote.sendLink")}
    data-label-check-email={t("vote.checkEmail")}
    data-label-error={t("vote.error")}
    data-label-thanks={t("vote.thanks")}
    data-email-placeholder={t("vote.emailPlaceholder")}
    data-count-template={t("vote.count", { n: "{n}" })}
  >
    <button class="btn" type="button" id="vote-btn" disabled>{t("vote.like")}</button>
    <span style="color:var(--muted);font-size:13px;margin-inline-start:8px" id="vote-status">
      {t("vote.count", { n: person.votes30 })}
    </span>
  </div>
</Layout>

<script>
  import { track } from "../../../lib/analytics";
  import { getSupabaseClient, votingConfigured } from "../../../lib/supabase";

  track("view_profile", { id: window.location.pathname.split("/").filter(Boolean).pop() ?? "" });

  const widget = document.getElementById("vote-widget");
  const btn = document.getElementById("vote-btn") as HTMLButtonElement | null;
  const status = document.getElementById("vote-status");
  if (widget && btn && status) {
    const influencerId = widget.dataset.influencerId!;
    const labels = {
      vote: widget.dataset.labelVote!,
      done: widget.dataset.labelDone!,
      signIn: widget.dataset.labelSignIn!,
      send: widget.dataset.labelSend!,
      checkEmail: widget.dataset.labelCheckEmail!,
      error: widget.dataset.labelError!,
      thanks: widget.dataset.labelThanks!,
    };
    const emailPlaceholder = widget.dataset.emailPlaceholder!;
    const countTemplate = widget.dataset.countTemplate!;
    const votes30 = Number(widget.dataset.votes30 ?? "0");
    const countLabel = countTemplate.replace("{n}", String(votes30));

    function showEmailForm() {
      widget.innerHTML = "";
      const form = document.createElement("form");
      form.className = "vote-email-form";
      form.style.cssText = "display:flex;gap:8px;align-items:center;flex-wrap:wrap";
      const input = document.createElement("input");
      input.type = "email";
      input.required = true;
      input.placeholder = emailPlaceholder;
      input.className = "vote-email-input";
      input.style.cssText =
        "padding:8px 12px;border-radius:8px;border:1px solid var(--rule);background:var(--surface);color:var(--ink)";
      const sendBtn = document.createElement("button");
      sendBtn.type = "submit";
      sendBtn.className = "btn";
      sendBtn.textContent = labels.send;
      form.append(input, sendBtn);
      widget.append(form);
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        sendBtn.disabled = true;
        try {
          const supabase = getSupabaseClient();
          const { error } = await supabase.auth.signInWithOtp({
            email: input.value,
            options: { emailRedirectTo: window.location.href },
          });
          if (error) throw error;
          widget.textContent = labels.checkEmail;
        } catch {
          widget.textContent = labels.error;
        }
      });
    }

    async function castVote(userId: string) {
      btn.disabled = true;
      try {
        const supabase = getSupabaseClient();
        const { error } = await supabase.from("votes").insert({ user_id: userId, influencer_id: influencerId });
        if (error && error.code !== "23505") throw error; // 23505 = ya había votado hoy (PK duplicado)
        btn.textContent = labels.done;
        status.textContent = labels.thanks;
      } catch {
        btn.disabled = false;
        status.textContent = labels.error;
      }
    }

    async function checkVotedToday(userId: string): Promise<boolean> {
      const supabase = getSupabaseClient();
      const today = new Date().toISOString().slice(0, 10);
      const { data } = await supabase
        .from("votes")
        .select("day")
        .eq("influencer_id", influencerId)
        .eq("day", today)
        .limit(1);
      return Boolean(data && data.length > 0);
    }

    async function init() {
      if (!votingConfigured()) return; // botón queda deshabilitado tal como venía por defecto
      btn.disabled = false;
      btn.removeAttribute("aria-disabled");
      btn.removeAttribute("title");

      const supabase = getSupabaseClient();
      const {
        data: { session },
      } = await supabase.auth.getSession();

      if (session) {
        if (await checkVotedToday(session.user.id)) {
          btn.textContent = labels.done;
          btn.disabled = true;
        } else {
          btn.addEventListener("click", () => castVote(session.user.id), { once: true });
        }
      } else {
        btn.addEventListener(
          "click",
          () => {
            status.textContent = labels.signIn;
            showEmailForm();
          },
          { once: true },
        );
      }
    }

    init();
  }
</script>
