---
import Layout from "../../components/Layout.astro";
import RankingRow from "../../components/RankingRow.astro";
import { siteConfig, type LanguageCode } from "../../../site.config";
import { translator } from "../../lib/i18n";
import { people, rankingMeta, getTopics } from "../../lib/data";
import { formatDate } from "../../lib/format";
import { PLATFORM_LABELS, type Platform } from "../../../pipeline/config.js";

export function getStaticPaths() {
  return siteConfig.languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: LanguageCode };
const t = translator(lang);
const top100 = people.slice(0, 100);
const platforms = [...new Set(top100.map((p) => p.mainPlatform).filter(Boolean))] as Platform[];
const topics = getTopics(lang);
const uxLabels = {
  es: ["Buscar creador", "Nombre del creador…", "Limpiar filtros", "{shown} de {total} perfiles", "Explora los perfiles y descubre qué hay detrás de cada puntuación."],
  en: ["Find a creator", "Creator name…", "Clear filters", "{shown} of {total} profiles", "Explore profiles and discover what goes into each score."],
  pt: ["Buscar criador", "Nome do criador…", "Limpar filtros", "{shown} de {total} perfis", "Explore os perfis e descubra como cada pontuação é calculada."],
  fr: ["Rechercher un créateur", "Nom du créateur…", "Effacer les filtres", "{shown} sur {total} profils", "Explorez les profils et découvrez le détail de chaque score."],
  de: ["Creator suchen", "Name des Creators…", "Filter zurücksetzen", "{shown} von {total} Profilen", "Entdecke die Profile und erfahre, wie sich jeder Score zusammensetzt."],
  ru: ["Найти автора", "Имя автора…", "Сбросить фильтры", "{shown} из {total} профилей", "Изучите профили и узнайте, из чего складывается оценка."],
  ar: ["ابحث عن صانع محتوى", "اسم صانع المحتوى…", "مسح الفلاتر", "{shown} من {total} ملفًا", "استكشف الملفات وتعرّف على تفاصيل كل نتيجة."],
  hi: ["क्रिएटर खोजें", "क्रिएटर का नाम…", "फ़िल्टर हटाएँ", "{total} में से {shown} प्रोफ़ाइल", "प्रोफ़ाइल देखें और जानें कि हर स्कोर कैसे बनता है।"],
  zh: ["搜索创作者", "创作者姓名…", "清除筛选", "显示 {shown} / {total} 个资料", "探索创作者资料，了解每项评分的依据。"],
  ja: ["クリエイターを検索", "クリエイター名…", "絞り込みを解除", "{total} 件中 {shown} 件", "プロフィールを見て、スコアの内訳を確認しましょう。"],
}[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout lang={lang} path="" title={t("nav.world")} activeNav="world">
  <section class="hero">
    <div>
      <div class="eyebrow"><span class="pulse" aria-hidden="true"></span>{t("hero.eyebrow")}</div>
      <h1>{t("hero.title")} <span>{t("hero.titleHighlight")}</span></h1>
      <p class="lead">{t("hero.lead")}</p>
      <div class="hero-actions">
        <a class="btn primary" href="#ranking">{t("hero.ctaExplore")}</a>
        <a class="btn" href={`${base}/${lang}/metodo/`}>{t("hero.ctaMethod")}</a>
      </div>
      <div class="trust">
        <span><i aria-hidden="true">✓</i> {t("hero.trust1")}</span>
        <span><i aria-hidden="true">✓</i> {t("hero.trust2")}</span>
        <span><i aria-hidden="true">✓</i> {t("hero.trust3")}</span>
      </div>
    </div>
    <div class="intro-film">
      <div class="phone-frame">
        <span class="phone-side-button" aria-hidden="true"></span>
        <div class="phone-screen">
          <div class="phone-top" aria-hidden="true"><span class="phone-island"></span></div>
      <video controls playsinline preload="metadata" aria-label={lang === "es" ? `Presentación de ${siteConfig.brandName} en español` : `${siteConfig.brandName} introduction in English`}>
        <source src={`${base}/videos/intro-${lang === "es" ? "es" : "en"}.mp4`} type="video/mp4" />
        <a href={`${base}/videos/intro-${lang === "es" ? "es" : "en"}.mp4`}>{lang === "es" ? "Ver video" : "Watch video"}</a>
      </video>
          <div class="phone-bottom" aria-hidden="true"><span></span></div>
        </div>
      </div>
      <p>{lang === "es" ? "Descubre una nueva forma de entender la influencia." : "Discover a new way to understand influence."}</p>
    </div>
  </section>

  <div class="weekline" id="ranking">
    <h2>{t("home.title")}</h2>
    <span>{t("rank.updated", { date: formatDate(rankingMeta.generatedAt, lang) })}</span>
  </div>

  <p class="ranking-intro">{uxLabels[4]}</p>
  <form class="filters" id="filters" role="search" aria-label={uxLabels[0]}>
    <div class="creator-search">
      <label for="f-search">{uxLabels[0]}</label>
      <input id="f-search" type="search" name="creator" placeholder={uxLabels[1]} autocomplete="off" />
    </div>
    <div>
      <label for="f-topic">{t("home.filterTopicLabel")}</label>
      <select id="f-topic" name="topic">
        <option value="">{t("home.filterAllOption")}</option>
        {topics.map((topic) => <option value={topic}>{topic}</option>)}
      </select>
    </div>
    <div>
      <label for="f-platform">{t("home.filterPlatformLabel")}</label>
      <select id="f-platform" name="platform">
        <option value="">{t("home.filterAllOption")}</option>
        {platforms.map((platform) => <option value={platform}>{PLATFORM_LABELS[platform]}</option>)}
      </select>
    </div>
    <button class="btn clear-filters" type="reset">{uxLabels[2]}</button>
  </form>
  <p class="result-count" id="result-count" role="status" aria-live="polite" aria-atomic="true" data-template={uxLabels[3]}>
    {uxLabels[3].replace("{shown}", String(top100.length)).replace("{total}", String(top100.length))}
  </p>

  <div class="board" id="board">
    {
      top100.length > 0 ? (
        top100.map((person, i) => (
          <RankingRow person={person} position={i + 1} prevPosition={person.rankPrev} lang={lang} lead={i === 0} />
        ))
      ) : (
        <div class="empty">{t("home.empty")}</div>
      )
    }
  </div>
  <p id="empty-filtered" class="empty" hidden>{t("home.empty")}</p>

  {
    top100.length > 20 && (
      <p style="text-align:center;margin-top:14px">
        <button class="btn" id="see-more" type="button">
          {t("home.seeMore")}
        </button>
      </p>
    )
  }

  <section class="business-box" id="marcas">
    <div>
      <div class="eyebrow">{t("business.eyebrow")}</div>
      <h2 class="cond" style="margin:13px 0 8px;font-size:26px">{t("business.title")}</h2>
      <p>{t("business.lead")}</p>
      <a class="btn primary" href="mailto:contacto@fykin.com?subject=Fykin%20para%20marcas">
        {t("business.cta")}
      </a>
    </div>
    <div class="price-note">
      <b>{t("business.priceNote")}</b>
      <span>{t("business.priceCaption")}</span>
    </div>
  </section>
</Layout>

<script>
  const board = document.getElementById("board")!;
  const rows = Array.from(board.querySelectorAll<HTMLElement>(".row"));
  const seeMoreBtn = document.getElementById("see-more");
  const emptyFiltered = document.getElementById("empty-filtered")!;
  const topicSelect = document.getElementById("f-topic") as HTMLSelectElement;
  const platformSelect = document.getElementById("f-platform") as HTMLSelectElement;

  const searchInput = document.getElementById("f-search") as HTMLInputElement;
  const filterForm = document.getElementById("filters") as HTMLFormElement;
  const resultCount = document.getElementById("result-count")!;
  const normalize = (value: string) => value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLocaleLowerCase().trim();
  let visibleCount = 20;

  function applyFilters() {
    const query = normalize(searchInput.value);
    const matches = rows.filter((row) =>
      (!topicSelect.value || row.dataset.topic === topicSelect.value) &&
      (!platformSelect.value || row.dataset.platform === platformSelect.value) &&
      (!query || normalize(row.dataset.name ?? "").includes(query))
    );
    const visible = new Set(matches.slice(0, visibleCount));
    rows.forEach((row) => { row.hidden = !visible.has(row); });
    emptyFiltered.hidden = matches.length > 0;
    if (seeMoreBtn) seeMoreBtn.hidden = matches.length <= visibleCount;
    resultCount.textContent = resultCount.dataset.template!
      .replace("{shown}", String(visible.size)).replace("{total}", String(matches.length));
  }
  filterForm.addEventListener("submit", (event) => event.preventDefault());
  filterForm.addEventListener("input", () => { visibleCount = 20; applyFilters(); });
  filterForm.addEventListener("reset", () => {
    searchInput.value = "";
    topicSelect.value = "";
    platformSelect.value = "";
    visibleCount = 20;
    applyFilters();
  });
  seeMoreBtn?.addEventListener("click", () => {
    visibleCount += 20;
    applyFilters();
  });
  applyFilters();
</script>
