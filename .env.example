# Copia este archivo a .env para correr `npm run pipeline` en local.
# En producción estas mismas claves van como GitHub Secrets del repositorio
# (nunca en el repo). Ver docs/FUENTES_DE_DATOS.md.

# Fase 3 — YouTube Data API v3
YOUTUBE_API_KEY=

# Fase 3 — Instagram Graph API (Business Discovery) y Facebook Graph API
META_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Fase 5 — Supabase (votos). PUBLIC_* las usa el sitio en el navegador (clave
# anónima); SUPABASE_SERVICE_ROLE_KEY la usa solo el pipeline, nunca el navegador.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fase 7 — TikTok for Developers (Login Kit / Display API). CLIENT_KEY/SECRET los
# usa el pipeline para refrescar el access_token; deben ser del mismo entorno
# (Salvadera o Producción) que usó supabase/functions/tiktok-callback para emitir
# el refresh_token guardado en creator_tokens. TOKEN_KEY es la clave AES-256-GCM
# (misma que el secreto TIKTOK_TOKEN_KEY de la Edge Function) para descifrarlo.
# PUBLIC_* las usa el sitio en el navegador para armar el link de autorización.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_TOKEN_KEY=
PUBLIC_TIKTOK_CLIENT_KEY=
PUBLIC_TIKTOK_REDIRECT_URI=
